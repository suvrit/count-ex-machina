% cxcase.sty -- the counterexample case format for count-ex-machina.
%
% A case is one counterexamples/<id>/case.tex, written as a sequence of regions:
%
%   \cxtitle{...}                                 the case heading
%   \cxsubtitle{...}                              a heading inside it (optional)
%   \begin{cxcredits}  ... \end{cxcredits}      \posedby \foundby \formalizedby ...
%   \begin{cxcontext}  ... \end{cxcontext}      our setup prose (optional)
%   \begin{cxsource}{r}... \end{cxsource}       who posed result r, and where
%   \begin{cxstatement}{r} ... \end{cxstatement}  r as originally posed (boxed,
%                                                 and labelled \label{ctx:r})
%   \begin{cxsummary}{r}   ... \end{cxsummary}    r's ledger statement cell
%   \begin{cxcertificate}{r} ... \end{cxcertificate}  r's ledger certificate cell
%   \begin{cxrefutation} ... \end{cxrefutation}   the theorem and its proof
%
% These are real LaTeX environments, so an unclosed or misspelled one is a
% compile error rather than something a parser has to be taught to notice, and
% a case compiles on its own (see \cxstandalone below and `make preview`).
%
% The ledger is not assembled here.  cxsummary and cxcertificate only delimit
% the two columns; tools/build.py reads them and writes the rows to
% tex/generated/ledger.tex, and the table that holds those rows sits in
% main.tex where it can be restyled by hand.
%
% What this package does NOT know is metadata: each result's theorem label, and
% whether its quoted statement is verbatim or a paraphrase, live in the per-case
% case.json and reach LaTeX through tex/generated/metadata.tex, which
% tools/build.py writes.  Where a case sits -- its section heading, its level,
% its order -- is written by hand in tex/cases.tex and tex/09-additional.tex.
% Prose is LaTeX's; facts are the JSON's.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cxcase}[2026/08/02 v1.0 count-ex-machina case format]

\RequirePackage{environ}
\RequirePackage{etoolbox}
\RequirePackage{amsmath,amssymb,amsthm,mathtools}
\RequirePackage{booktabs,longtable,array}
\RequirePackage{xcolor}
\RequirePackage[most]{tcolorbox}

% ---------------------------------------------------------------------------
% Status tags and the shared notation every case may use.
% ---------------------------------------------------------------------------
\newcommand{\statusproved}{\textbf{[Proof]}}
\newcommand{\statusfalse}{\textbf{[Disproof]}}
\newcommand{\statusnumeric}{\textbf{[NUMERICALLY VETTED]}}
\newcommand{\statusconditional}{\textbf{[CONDITIONAL]}}
\newcommand{\statusspeculative}{\textbf{[SPECULATIVE]}}
\newcommand{\R}{\mathbb R}
\newcommand{\C}{\mathbb C}
\newcommand{\tr}{\operatorname{tr}}
\newcommand{\per}{\operatorname{per}}
\newcommand{\Imm}{\operatorname{Imm}}
\newcommand{\diag}{\operatorname{diag}}
\newcommand{\Vol}{\operatorname{Vol}}
\newcommand{\CE}{\mathsf{CE}}
\newcommand{\J}{\mathsf{J}}
\DeclareMathOperator{\Diag}{diag}

\newcommand{\nlsum}{\sum\nolimits}

\newcommand{\disc}{\operatorname{disc}}

\definecolor{darkblue}{rgb}{0.0,0.0,0.75}
\newcommand{\db}[1]{\textbf{\textcolor{darkblue}{#1}}}

% Certificate-level tags used in tex/ledger.tex; expanded in the table caption.
\definecolor{darkgreen}{rgb}{0.0,0.5,0.0}
\newcommand{\ec}{\textit{\textcolor{darkgreen}{[EC]}}}
\newcommand{\ic}{\textit{\textcolor{darkgreen}{[IC]}}}

% \cxn -- the ledger's row number, in the margin column of tex/ledger.tex.
% Auto-incrementing, so rows can be inserted, reordered or deleted without
% renumbering anything by hand.  \refstepcounter rather than \stepcounter so a
% row can carry a \label and be cited as "item 9" from the prose.  Reset with
% \setcounter{cxrow}{0} before the table.  Do not put \cxn in a longtable head:
% heads are typeset once per page and the counter would run ahead.
\newcounter{cxrow}
\newcommand{\cxn}{\refstepcounter{cxrow}\db{\thecxrow.}}

\newtheorem{theorem}{Theorem}[section]
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{corollary}[theorem]{Corollary}
\theoremstyle{definition}
\newtheorem{problem}[theorem]{Problem}
\newtheorem{definition}[theorem]{Definition}
\newtheorem{example}[theorem]{Example}
\newtheorem{audit}[theorem]{Audit finding}
\theoremstyle{remark}
\newtheorem{remark}[theorem]{Remark}

% Statements quoted as originally posed are boxed, so that the source's words
% are never mistaken for our restatement of them.
\tcolorboxenvironment{problem}{
  enhanced jigsaw, breakable,
  colback=blue!3!white, colframe=blue!45!black,
  boxrule=0.6pt, arc=2pt,
  left=8pt, right=8pt, top=7pt, bottom=7pt,
  borderline west={2.2pt}{-2.2pt}{blue!45!black},
  before skip=10pt, after skip=10pt,
}

% ---------------------------------------------------------------------------
% Metadata.  \cxlevel is set by hand in tex/cases.tex and tex/09-additional.tex,
% where the \input lines are; the rest is declared once, per result id, by the
% generated tex/generated/metadata.tex that main.tex loads in its preamble.
% ---------------------------------------------------------------------------
\newcommand{\cx@level}{section}
% \cxlevel{section|subsection} -- the level of every \cxtitle that follows,
% until the next \cxlevel.  Cases under a shared \section are subsections, so
% the heading level is a property of the case list, not of the case.
\newcommand{\cxlevel}[1]{\renewcommand{\cx@level}{#1}}
% \cxverbatim{result} / \cxparaphrase{result} -- whether the quoted statement
% is the source's own text.  Two commands rather than one with a value, so the
% test is \@ifundefined rather than a string comparison: comparing strings in
% TeX is a trap (\newcommand makes \long macros, \@namedef does not, and \ifx
% then reports two identical texts as different).  Anything not declared
% verbatim is treated as a paraphrase and labelled as one.
\newcommand{\cxverbatim}[1]{}
\newcommand{\cxparaphrase}[1]{\@namedef{cx@para@#1}{}}
% \cxtheorem{result}{label} -- the \label the case's theorem carries.  Labels
% are chosen by the author (thm:common-A, thm:pot), not derivable from the id,
% so the ledger and the per-result credit line are told rather than guessing.
\newcommand{\cxtheorem}[2]{\@namedef{cx@theorem@#1}{#2}}
\newcommand{\cx@theorem}[1]{%
  \@ifundefined{cx@theorem@#1}{thm:#1}{\@nameuse{cx@theorem@#1}}}
% ---------------------------------------------------------------------------
% Section separators.
% ---------------------------------------------------------------------------
% A rule closing each section, so a reader scanning the paper can see where one
% case stops and the next begins.  It is emitted *before* each heading rather
% than after each section's text, because "after" has no hook: a section ends
% wherever the next one starts.  \cxendrule closes the last one.  Sections only
% -- see the \pretocmd below for why subsections are left alone.
%
% Tune these three; set \cxsecrulewidth to 0pt to switch the rules off without
% touching anything else.
\newlength{\cxsecruleabove}\setlength{\cxsecruleabove}{16pt}
\newlength{\cxsecrulebelow}\setlength{\cxsecrulebelow}{0pt}
\newlength{\cxsecrulewidth}\setlength{\cxsecrulewidth}{0.4pt}
\newcommand{\cx@rule}{%
  \par
  % Keep the rule with the text it closes: a lone rule at the top of a page
  % reads as a mistake.  \addvspace rather than \vspace so consecutive skips
  % (the rule's, then the heading's own) collapse instead of accumulating.
  \penalty-40
  \addvspace{\cxsecruleabove}%
  \hrule height \cxsecrulewidth\relax
  \nobreak
  \addvspace{\cxsecrulebelow}%
}
% The first heading has no section before it to close.
\newif\ifcx@seenheading
\newcommand{\cx@headingrule}{%
  \ifcx@seenheading\cx@rule\else\global\cx@seenheadingtrue\fi}
% Only \section is hooked.  \subsection deliberately is not: a rule directly
% between a section heading and its first subsection, with no text between them,
% reads as a mistake.  Cases grouped as subsections are therefore separated by
% their headings alone.
\pretocmd{\section}{\cx@headingrule}{}{%
  \PackageWarning{cxcase}{Could not hook \string\section; section rules are off}}
% \cxendrule -- closes the final section, wherever the author wants it to end
% (before the acknowledgments, say, rather than after the bibliography).
\newcommand{\cxendrule}{\cx@rule}

% Every case is one \section, headed by its own \cxtitle; a case bundling
% several statements opens subsections with \cxsubtitle (below).  Until August
% 2026 two directories could share a section instead, headed by \cxgroup{...}
% emitted by the generator from a title table in tools/build.py -- the one
% section title in the paper nobody could edit where it was used.  The macro
% and the table entry are gone; the cases were merged into one directory.

% Appendices are ordinary \section's inside a hand-written \appendix, and the
% list of them at the end of the body is a hand-written list in main.tex.  Until
% August 2026 both went through this package: \cxappendix opened the generated
% appendix, \cxappendixsection registered a hand-written one, and each wrote a
% line into a private \jobname.apx contents stream that \cxappendixtoc read back
% (with a tex/latexmkrc rule to make latexmk rerun on it).  That spelled each
% title once, at the cost of a heading no one could edit where it was used.  All
% four macros and the .apx file are gone; write \section and edit the list.

% \cxbriefitem{item}{statement}{certificate}{path} -- one entry of the appendix
% list of statements recorded without a dossier.  The generator emits only these
% lines; the \begin{itemize} around them, the heading and the lead-in sentence
% are prose, and live in tex/09-additional.tex.
% The source item trails the statement rather than leading it: a ledger_label
% is free text ("Problem 5.1", but also "the identity after eq. (20) in 6.2"),
% so it cannot be relied on to read as a heading.
\newcommand{\cxbriefitem}[4]{%
  \item #2\ #3\ \emph{Source:} #1.\ \emph{Certificate:} \path{#4}.}

% ---------------------------------------------------------------------------
% Title and credits.
% ---------------------------------------------------------------------------
% A macro, not an environment: amsart sets subsection headings run-in, and a
% run-in heading issued from inside an environment is dropped when the group
% closes.  A title is one line anyway.
\newcommand{\cxtitle}[1]{\csname\cx@level\endcsname{#1}}
% \cxsubtitle{Heading} -- a heading inside a case that bundles several
% statements under one \cxtitle, one level below it: a subsection in the paper,
% a subsubsection in a preview (where the case itself is a subsection).  The
% level is looked up by name rather than compared as a string -- see \cxverbatim
% above for why.  Cases that refute more than one statement need not use it;
% it is for a case whose statements fall into parts with their own witnesses
% and credit lines, and it is the only way a case may open a heading of its
% own: cxrefutation carries no \section or \subsection.
\@namedef{cx@sub@section}{subsection}
\@namedef{cx@sub@subsection}{subsubsection}
\newcommand{\cxsubtitle}[1]{\csname\@nameuse{cx@sub@\cx@level}\endcsname{#1}}

% One macro per role, so that a per-result block can override a role and
% inherit the others.  Every role but one takes a single argument -- a person
% or a source.  \foundby takes two, {model}{date}, because it is the only role
% that is a claim about a machine's capability at a point in time: "Opus 5"
% says little without "2026-08".  The date is YYYY-MM, or YYYY-MM-DD when the
% day is worth recording; tools/build.py rejects any other spelling, and
% rejects a TODO in either argument unless run with --allow-todo.  \foundby
% accumulates: a witness may have taken more than one model or more than one
% session, and those read as one clause.
\let\cx@posed\@empty
\let\cx@found\@empty
\let\cx@formalized\@empty
\let\cx@audited\@empty
\let\cx@contributed\@empty
\newcommand{\posedby}[1]{\def\cx@posed{#1}}
\newcommand{\formalizedby}[1]{\def\cx@formalized{#1}}
\newcommand{\auditedby}[1]{\def\cx@audited{#1}}
\newcommand{\contributedby}[1]{\def\cx@contributed{#1}}
% \foundby accumulates *within* a block, but a per-result block that restates it
% replaces the case-level value rather than appending to it -- "roles not
% restated are inherited" means a restated role overrides.  Without this, a
% result whose finder differs from the case default reads as having been found
% by both, and tools/build.py (which merges key by key) would disagree with the
% typeset line.  \cx@inherited is true exactly while a block still carries the
% inherited default untouched.
\newif\ifcx@inherited
\newcommand{\foundby}[2]{%
  \ifcx@inherited
    \cx@inheritedfalse
    \let\cx@found\@empty
  \fi
  \ifx\cx@found\@empty
    \def\cx@found{#1 (#2)}%
  \else
    \g@addto@macro\cx@found{ and #1 (#2)}%
  \fi}

% A case-level block starts from nothing -- roles do not leak from the case
% before it -- and then becomes the default its own per-result blocks build on.
\newcommand{\cx@resetroles}{%
  \cx@inheritedfalse
  \global\let\cx@posed\@empty        \global\let\cx@found\@empty
  \global\let\cx@formalized\@empty   \global\let\cx@audited\@empty
  \global\let\cx@contributed\@empty}
% The case's own block becomes the default every per-result block starts from.
\newcommand{\cx@saveroles}{%
  \global\let\cx@d@posed\cx@posed        \global\let\cx@d@found\cx@found
  \global\let\cx@d@formalized\cx@formalized \global\let\cx@d@audited\cx@audited
  \global\let\cx@d@contributed\cx@contributed}
\newcommand{\cx@loadroles}{%
  \cx@inheritedtrue
  \let\cx@posed\cx@d@posed              \let\cx@found\cx@d@found
  \let\cx@formalized\cx@d@formalized    \let\cx@audited\cx@d@audited
  \let\cx@contributed\cx@d@contributed}
\cx@saveroles

\newcommand{\cx@printcredits}[1]{%
  \par\noindent{\small\itshape
    % The type word is written out because every theorem-like environment here
    % shares the theorem counter; a result whose \cxtheorem names a corollary or
    % a lemma needs this word changed by hand.  Every current one is a theorem.
    \if\relax\detokenize{#1}\relax\else Theorem~\ref{\cx@theorem{#1}}: \fi
    Posed by \cx@posed; counterexample found by \cx@found;
    formalized by \cx@formalized; audited by \cx@audited
    % Naming the same person twice in one line reads as a mistake, so a
    % contributor who also formalized the case is not repeated.
    \ifx\cx@contributed\cx@formalized\else; contributed by \cx@contributed\fi
    .}\par\medskip}

% Bare: the credit line for the whole case.  With [result-id]: the credits of
% one result, printed with a reference to its theorem, for a case whose bundled
% statements have different histories.  Roles not restated are inherited.
\newenvironment{cxcredits}[1][]{%
  \def\cx@this{#1}%
  \if\relax\detokenize{#1}\relax\cx@resetroles\else\cx@loadroles\fi
}{%
  \expandafter\cx@printcredits\expandafter{\cx@this}%
  \expandafter\if\relax\detokenize\expandafter{\cx@this}\relax\cx@saveroles\fi}

% ---------------------------------------------------------------------------
% Context, the statements as posed, and the refutation.
% ---------------------------------------------------------------------------
% Our own setup prose.  Deliberately outside the quote boxes below: nothing of
% ours may be mistaken for the source's words.
% Plain environments, not \NewEnviron: nothing here needs the body captured,
% and capturing it re-tokenises the prose, which perturbs the spacing TeX gives
% display math.  Only the regions that must store text for later (cxsource,
% cxsummary) or hand it to another environment (cxstatement) capture anything.
\newenvironment{cxcontext}{}{\par}

% Recorded, not typeset: the source becomes the heading of the quote box.
% \let, not \def{\BODY}: \BODY is reassigned by the next environment, so the
% region has to be snapshotted here rather than referenced later.
\NewEnviron{cxsource}[1]{%
  \global\expandafter\let\csname cx@source@#1\endcsname\BODY}
\newcommand{\cx@source}[1]{%
  \@ifundefined{cx@source@#1}{\PackageError{cxcase}%
    {No \string\begin{cxsource}{#1} before the statement}%
    {Every cxstatement{r} needs a cxsource{r} earlier in the file.}}%
    {\@nameuse{cx@source@#1}}}

% \cxpending{result} -- provenance not yet recorded.  The quote box is then
% omitted rather than printing a TODO into the paper; the missing source is
% reported by tools/build.py, which is where an unfilled field belongs.
\newcommand{\cxpending}[1]{\@namedef{cx@pending@#1}{}}
% Every quote box carries \label{ctx:<result id>}, so the prose says
% "Problem~\ref{ctx:aim-problem-35}" and gets the number of the box the reader
% is looking at.  Write that and never the source's own numbering ("Problem
% 35"): the source's number resolves to nothing here, and once two numbering
% schemes are loose in one document neither can be trusted.  The source's
% number is not lost -- it is in the box's heading, which cxsource sets.
% Result ids are unique across the archive (tools/build.py enforces it), so the
% id alone identifies the box.
%
% Emitted here rather than written into the case.tex files because a
% cxstatement body is the statement as posed and nothing else: tools/build.py
% copies it verbatim into registry.json as provenance.statement_tex, and a
% \label of ours sitting inside it would be recorded as part of the source's
% own words.  A pending result gets no label -- its box is discarded, so there
% is nothing to point at.
%
% The label is a plain \label: the document uses no cleveref, so a reference to
% a quote box is written "Problem~\ref{ctx:...}" with the word spelled out, as
% every other cross-reference here is.  (There used to be a \label[problem] and
% a pair of \crefname lines guarding against cleveref naming a box after the
% counter it steps -- the theorem counter -- and so calling it "Theorem 3.1".
% Without cleveref that hazard is gone, and \label takes no optional argument.)
\newenvironment{cxstatement}[1]{%
  % A pending result has no recorded source, so its placeholder is typeset into
  % a box that is then dropped -- nothing reaches the paper.
  \@ifundefined{cx@pending@#1}{%
    \begin{problem}[As posed\@ifundefined{cx@para@#1}{}{, paraphrased}:
        \cx@source{#1}]%
    \label{ctx:#1}%
  }{\cx@pendingtrue\setbox\@tempboxa\vbox\bgroup}%
}{%
  \ifcx@pending\egroup\cx@pendingfalse\else\end{problem}\fi}
\newif\ifcx@pending

\newenvironment{cxrefutation}{}{}

% ---------------------------------------------------------------------------
% The ledger cells.
% ---------------------------------------------------------------------------
% These two regions carry the ledger's columns, but nothing here typesets them.
% tools/build.py reads both and writes tex/generated/ledger.tex, and main.tex
% holds the table that \input's those rows -- so the ledger is visible and
% editable where it is used, rather than assembled by a macro out of sight.
%
% Until August 2026 each cxcertificate instead wrote a row into the .aux file
% for a \cxledger macro to typeset on the next pass.  That worked, but it hid
% the whole table inside this package and made the ledger need two runs to
% appear.  Both regions now simply swallow their bodies.
\NewEnviron{cxsummary}[1]{}
\NewEnviron{cxcertificate}[1]{}

% ---------------------------------------------------------------------------
% Standalone preview: `make preview CASE=<id>` wraps one case in a minimal
% document so it can be compiled while it is being written.  The ledger regions
% record rather than typeset, so a preview shows the case, not the table.
% ---------------------------------------------------------------------------
\newcommand{\cxstandalone}[1]{%
  \section*{Preview: \texttt{#1}}%
  \renewcommand{\cx@level}{subsection}}
\endinput
